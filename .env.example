# Public application URL
APP_URL=https://wiup.vn
API_URL=https://api.wiup.vn
NODE_ENV=production

# PostgreSQL (server-side only; NEVER expose as VITE_* variables)
DATABASE_URL=
DB_SSL=true
DB_POOL_MAX=5

# Core authentication & security secrets (server-side only)
JWT_SECRET=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_INITIAL_PASSWORD=

# Optional development/demo bootstrap credentials; do not use as production defaults
DEMO_INITIAL_PASSWORD=
STAFF_INITIAL_PASSWORD=

# Email provider (server-side only)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=

# SMS provider (server-side only)
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
