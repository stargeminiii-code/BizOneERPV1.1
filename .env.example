# Frontend API base URL
# Production is automatically routed to https://api.wiup.vn when hosted on wiup.vn.
# Set this explicitly for local/staging environments when needed.
VITE_API_BASE_URL=https://api.wiup.vn

# Render backend / security variables (set in Render, never commit secrets)
SUPER_ADMIN_INITIAL_PASSWORD=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
JWT_SECRET=

# Optional email/SMS providers for OTP
EMAIL_HOST=
EMAIL_USER=
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
