# Frontend API base URL
# Production is automatically routed to https://api.wiup.vn when hosted on wiup.vn.
# Set this explicitly for local/staging environments when needed.
VITE_API_BASE_URL=https://api.wiup.vn

# AI & Platform URLs
GEMINI_API_KEY=
APP_URL=

# Core Authentication & Security Secrets (Server-Side Only)
JWT_SECRET=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_PASSWORD=
DEMO_INITIAL_PASSWORD=
STAFF_INITIAL_PASSWORD=

# Email Provider Configuration (SMTP / API)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=

# SMS Provider Configuration (VN SMS / Twilio / Custom API)
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
